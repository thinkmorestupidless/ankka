#!/bin/sh
# Refuses a commit whose message is not a Conventional Commit (https://www.conventionalcommits.org/en/v1.0.0/).
#
# Enable once per clone:  git config core.hooksPath .githooks   (or `just hooks`)
#
# The header is `<type>(<scope>)!: <description>`: a type from the list below, an optional lower-case
# scope (the spec number for spec work, `feat(057): ...`, otherwise the area), `!` when the change is
# breaking, then a description that starts in lower case and has no trailing period, the whole line
# under 72 characters. The body and footers are free, except that a breaking change says what breaks
# and how to migrate in a `BREAKING CHANGE:` footer. Messages git writes itself (merges, fixup! and
# squash! commits, `git revert`'s "Revert ...") pass unchanged. `--no-verify` bypasses it, as with any
# hook; CI does not check messages, so the hook is the only gate.
set -eu

msg="$1"
# The first line that is neither a comment nor blank: the editor leaves git's commented template in.
header=$(grep -v '^#' "$msg" | sed '/./,$!d' | head -n 1)

case "$header" in
  "Merge "*|"Revert \""*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

types='feat|fix|docs|test|refactor|perf|build|ci|chore|style|revert'
if ! printf '%s\n' "$header" | grep -Eq "^($types)(\([a-z0-9][a-z0-9._/-]*\))?!?: [a-z0-9\`\"'(\[{<@]"; then
  cat >&2 <<EOF
commit-msg: not a Conventional Commit header:

    $header

Write: <type>(<scope>): <description>   e.g.  feat(057): project tokens and the administrator
Types: ${types}. Scope: the spec number, or the area (cli, operator, docs, deps).
Description in lower case, imperative, no trailing period. Add ! before the colon for a breaking
change, and a "BREAKING CHANGE: <what and how to migrate>" footer. --no-verify bypasses this hook.
EOF
  exit 1
fi

if [ "${#header}" -gt 72 ]; then
  echo "commit-msg: the header is ${#header} characters; keep it under 72 and put the rest in the body" >&2
  exit 1
fi

case "$header" in
  *.) echo "commit-msg: no trailing period on the header" >&2; exit 1 ;;
esac

if printf '%s\n' "$header" | grep -Eq '^[a-z]+(\([^)]*\))?!:' && ! grep -Eq '^BREAKING[ -]CHANGE: .' "$msg"; then
  echo "commit-msg: the header marks a breaking change with '!'; add a footer 'BREAKING CHANGE: <what breaks and how to migrate>'" >&2
  exit 1
fi
exit 0
