{
  // Node runs the server and the tests directly, so they are written in TypeScript that erases
  // (`erasableSyntaxOnly`) and import local files by their `.ts` name. Vite builds the app in src/.
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["server", "src", "test"]
}
