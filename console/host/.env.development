# The local defaults: the compose Keycloak on :8081 with the realm's development client secret, and
# `sbt controlPlane/run` on :9000. Read by `npm run dev` and `npm start` in this directory.
ANKKA_CONSOLE_CONTROL_PLANE_URL=http://localhost:9000
ANKKA_CONSOLE_CLIENT_SECRET=dev
ANKKA_CONSOLE_SESSION_SECRET=dev-session-secret
ANKKA_CONSOLE_ALLOW_INSECURE_ISSUER=true
ANKKA_CONSOLE_PORT=3000
