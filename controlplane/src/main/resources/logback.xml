<configuration>
  <!-- The control plane is an ankka service: a line written while it handles a request ends with
       the trace and span it belongs to, as the sidecar's does, and a line with neither ends as
       before. Without this file logback would log at DEBUG in its own default pattern. -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{24} - %msg%replace( trace_id=%X{trace_id} span_id=%X{span_id}){' trace_id= span_id=$', ''}%n</pattern>
    </encoder>
  </appender>
  <logger name="com.thinkmorestupidless.ankka" level="INFO"/>
  <logger name="org.apache.pekko" level="INFO"/>
  <logger name="io.r2dbc" level="WARN"/>
  <logger name="reactor" level="WARN"/>
  <logger name="io.fabric8" level="WARN"/>
  <logger name="io.netty" level="WARN"/>
  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
