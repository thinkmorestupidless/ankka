<configuration>
  <!-- The keyring's logging, as the operator's: INFO, with the clients it uses at WARN. Without this
       file logback logs everything at DEBUG, which was r2dbc's every message to and from the
       keyring's database, and the one line that said why the keyring would not start was a few
       among thousands. -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{24} - %msg%n</pattern>
    </encoder>
  </appender>
  <logger name="ankka.keyring" level="INFO"/>
  <logger name="com.thinkmorestupidless.ankka" level="INFO"/>
  <logger name="io.r2dbc" level="WARN"/>
  <logger name="reactor" level="WARN"/>
  <logger name="io.netty" level="WARN"/>
  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
