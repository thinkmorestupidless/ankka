<!-- The proxy's test logging, selected by -Dlogback.configurationFile in build.sbt. It is not named
     logback-test.xml because ankka-testkit and http's tests, both test dependencies here, ship one:
     with two on the classpath logback warns, dumps its status and picks whichever comes first. -->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern></encoder>
  </appender>
  <logger name="ankka.proxy" level="DEBUG"/>
  <logger name="com.thinkmorestupidless.ankka.proxy" level="DEBUG"/>
  <root level="INFO"><appender-ref ref="STDOUT"/></root>
</configuration>
