  "components": {
    "schemas": {
      "AnkkaProblem": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "error"
        ]
      },
      "Cart": {
        "type": "object",
        "properties": {
          "cartId": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineItem"
            }
          },
          "checkedOut": {
            "type": "boolean"
          }
        },
        "required": [
          "cartId",
          "checkedOut"
        ]
      },
      "CheckoutSeen": {
        "type": "object",
        "properties": {
          "cartId": {
            "type": "string"
          },
          "at": {
            "type": "integer",
            "format": "int64"
          },
          "notices": {
            "type": "integer"
          }
        },
        "required": [
          "cartId",
          "at",
          "notices"
        ]
      },
      "IssuedClientKey": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "clientKey": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "clientKey"
        ]
      },
      "KeyRequest": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string"
          },
          "scope": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "subject"
        ]
      },
      "LineItem": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          }
        },
        "required": [
          "productId",
          "name",
          "quantity"
        ]
      },
      "Receipt": {
        "type": "object",
        "properties": {
          "cartId": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "items": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "copies": {
            "type": "integer"
          }
        },
        "required": [
          "cartId",
          "note",
          "items",
          "currency",
          "copies"
        ]
      }
    }
