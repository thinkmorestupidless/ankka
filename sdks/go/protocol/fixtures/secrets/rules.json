{
  "about": "The rules for a service secret's name and value. Each row builds its text as `unit` repeated `repeat` times, so a long one need not be written out. A name is 1 to 253 characters, each a letter, a digit, '.', '_', '-' or '/'. A value is not empty and at most 65536 bytes as UTF-8. Every SDK's store and every unit-test double gives each row's verdict.",
  "names": [
    {"unit": "acme", "repeat": 1, "accepted": true, "why": "letters"},
    {"unit": "provider/acme", "repeat": 1, "accepted": true, "why": "a slash is a separator"},
    {"unit": "a.b_c-d/E9", "repeat": 1, "accepted": true, "why": "every permitted character"},
    {"unit": "a", "repeat": 253, "accepted": true, "why": "the longest name"},
    {"unit": "a", "repeat": 254, "accepted": false, "why": "longer than 253 characters"},
    {"unit": "", "repeat": 1, "accepted": false, "why": "empty"},
    {"unit": "provider acme", "repeat": 1, "accepted": false, "why": "a space"},
    {"unit": "provider:acme", "repeat": 1, "accepted": false, "why": "a colon"},
    {"unit": "provider\tacme", "repeat": 1, "accepted": false, "why": "a tab"},
    {"unit": "café", "repeat": 1, "accepted": false, "why": "a letter outside ASCII"}
  ],
  "values": [
    {"unit": "x", "repeat": 1, "accepted": true, "why": "one byte"},
    {"unit": "x", "repeat": 65536, "accepted": true, "why": "the largest value"},
    {"unit": "", "repeat": 1, "accepted": false, "why": "empty"},
    {"unit": "x", "repeat": 65537, "accepted": false, "why": "one byte over the limit"},
    {"unit": "é", "repeat": 32769, "accepted": false, "why": "32769 characters of two bytes each: the limit is in bytes, not characters"}
  ]
}
