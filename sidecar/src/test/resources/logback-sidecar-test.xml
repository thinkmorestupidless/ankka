<!-- The sidecar's test logging, selected by -Dlogback.configurationFile in build.sbt. It is not named
     logback-test.xml because ankka-testkit, a test dependency here, ships one: with two on the
     classpath logback warns, dumps its status and picks whichever comes first. -->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern></encoder>
  </appender>
  <logger name="com.thinkmorestupidless.ankka.runtime.remote" level="DEBUG"/>
  <logger name="com.thinkmorestupidless.ankka.sidecar" level="DEBUG"/>
  <logger name="com.github.dockerjava" level="WARN"/>
  <root level="INFO"><appender-ref ref="STDOUT"/></root>
</configuration>
